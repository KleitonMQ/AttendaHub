        "query": "SELECT\n    telefone,\n    STRING_AGG(mensagem, E'\\n' ORDER BY criado_em, id) AS mensagem,\n    MIN(id) AS primeira_id,\n    ARRAY_AGG(id ORDER BY criado_em, id) AS ids,\n    MIN(atendimento_id) AS atendimento_id,\n    MIN(tipo) AS tipo\nFROM fila_mensagens\nWHERE telefone = (\n    SELECT telefone\n    FROM fila_mensagens\n    WHERE status = 'PENDENTE'\n      AND criado_em <= NOW() - INTERVAL '15 seconds'\n    ORDER BY criado_em ASC, id ASC\n    LIMIT 1\n)\nAND status = 'PENDENTE'\nGROUP BY telefone;",
        "options": {}
