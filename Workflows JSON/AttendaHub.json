    {
      "parameters": {
        "jsCode": "try {\n  const data = JSON.parse($json.body.jsonData);\n\n  if (data.type !== \"Message\") {\n    return [];\n  }\n  \n  return [\n    {\n      json: {\n        instanceName: $json.body.instanceName || \"\",\n\n        isFromMe: data?.event?.Info?.IsFromMe ?? false,\n\n        isGroup: data?.event?.Info?.IsGroup ?? false,\n\n        nome: data?.event?.Info?.PushName || \"\",\n\n        numero: data?.event?.Info?.SenderAlt || data?.event?.Info?.Chat || \"\",\n\n        chatId: data?.event?.Info?.Chat || \"\",\n\n        mensagem:\n          data?.event?.Message?.extendedTextMessage?.text ||\n          data?.event?.Message?.conversation ||\n          \"\",\n\n        dataHora: data?.event?.Info?.Timestamp || \"\",\n\n        tipoMensagem:\n          data?.event?.Info?.MediaType || data?.event?.Info?.Type || \"unknown\",\n\n        // ID da mensagem recebida\n        messageId: data?.event?.Info?.ID || \"\",\n\n        // participante que enviou\n        participant:\n          data?.event?.Info?.SenderAlt || data?.event?.Info?.Sender || \"\",\n\n        // tipo principal do evento\n        eventType: data?.type || \"\",\n\n        // grupo ou conversa\n        addressingMode: data?.event?.Info?.AddressingMode || \"\",\n\n        // telefone limpo para envio\n        phone: (data?.event?.Info?.SenderAlt || data?.event?.Info?.Chat || \"\").split(':')[0]\n          .replace(\"@s.whatsapp.net\", \"\")\n          .replace(\"@lid\", \"\")\n          .replace(\"@g.us\", \"\"),\n      },\n    },\n  ];\n} catch (error) {\n  return [\n    {\n      json: {\n        erro: true,\n        mensagemErro: error.message,\n        payloadOriginal: $json,\n      },\n    },\n  ];\n}\n"
      },
