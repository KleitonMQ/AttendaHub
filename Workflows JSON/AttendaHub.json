      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    CASE\n        WHEN EXTRACT(ISODOW FROM CURRENT_DATE) IN (6, 7) THEN false\n\n        WHEN EXISTS (\n            SELECT 1\n            FROM feriado\n            WHERE data = CURRENT_DATE\n        ) THEN false\n\n        WHEN CURRENT_TIME BETWEEN TIME '08:00' AND TIME '11:50'\n            THEN true\n\n        WHEN CURRENT_TIME BETWEEN TIME '13:00' AND TIME '16:50'\n            THEN true\n\n        ELSE false\n    END AS dentro_horario;",
